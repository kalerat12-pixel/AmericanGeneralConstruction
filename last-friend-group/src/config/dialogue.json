    {
      "id": "s6",
      "name": "fight",
      "title": "DAY 14",
      "subtitle": "THE INCIDENT",
      "duration": 30.58,
      "lines": [
        {
          "id": "s6_01",
          "speaker": "marcus",
          "text": "Who. Ate. The last. Pizza rolls.",
          "at": 2.1,
          "hold": 2.92
        },
        {
          "id": "s6_02",
          "speaker": "jace",
          "text": "Don't look at me.",
          "at": 5.37,
          "hold": 1.0
        },
        {
          "id": "s6_03",
          "speaker": "dev",
          "text": "It was Tank. It's always Tank.",
          "at": 6.39,
          "hold": 2.13
        },
        {
          "id": "s6_04",
          "speaker": "tank",
          "text": "I was asleep for two days.",
          "at": 8.92,
          "hold": 1.66
        },
        {
          "id": "s6_05",
          "speaker": "marcus",
          "text": "Those were the last pizza rolls on EARTH, probably!",
          "at": 10.98,
          "hold": 2.75
        },
        {
          "id": "s6_06",
          "speaker": "jace",
          "text": "So go to another store! Every store is ours!",
          "at": 13.93,
          "hold": 2.9
        },
        {
          "id": "s6_07",
          "speaker": "marcus",
          "text": "It's not about the pizza rolls! It's about TRUST!",
          "at": 17.04,
          "hold": 2.86
        },
        {
          "id": "s6_08",
          "speaker": "dev",
          "text": "It's a little bit about the pizza rolls.",
          "at": 20.4,
          "hold": 1.84
        },
        {
          "id": "s6_09",
          "speaker": "jace",
          "text": "That's it. I'm starting my OWN friend group.",
          "at": 22.64,
          "hold": 2.52
        },
        {
          "id": "s6_10",
          "speaker": "dev",
          "text": "With WHO?",
          "at": 25.36,
          "tts": "With who?",
          "hold": 1.0
        },
        {
          "id": "s6_11",
          "speaker": "jace",
          "text": "...I'll figure it out!",
          "at": 26.16,
          "hold": 1.0
        }
      ]
    },
