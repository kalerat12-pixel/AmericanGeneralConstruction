    {
      "id": "s2",
      "name": "rules",
      "title": "DAY 1",
      "subtitle": "RULES",
      "duration": 31.58,
      "lines": [
        {
          "id": "s2_01",
          "speaker": "marcus",
          "text": "Okay, listen up. Day one of the apocalypse. We need rules.",
          "at": 2.1,
          "hold": 4.13
        },
        {
          "id": "s2_02",
          "speaker": "marcus",
          "text": "Rule one. Nobody goes anywhere alone.",
          "at": 6.68,
          "hold": 2.43
        },
        {
          "id": "s2_03",
          "speaker": "jace",
          "text": "Cool. Bye!",
          "at": 9.37,
          "hold": 1.15
        },
        {
          "id": "s2_04",
          "speaker": "marcus",
          "text": "Rule two. We ration the food.",
          "at": 11.82,
          "hold": 2.24
        },
        {
          "id": "s2_05",
          "speaker": "tank",
          "text": "It's rationed. Into me.",
          "at": 14.96,
          "hold": 2.8
        },
        {
          "id": "s2_06",
          "speaker": "marcus",
          "text": "Rule three. The emergency radio stays on. At all times.",
          "at": 18.37,
          "hold": 4.19
        },
        {
          "id": "s2_07",
          "speaker": "dev",
          "text": "Bro, it's literally just static.",
          "at": 22.91,
          "hold": 1.76
        },
        {
          "id": "s2_08",
          "speaker": "marcus",
          "text": "...Okay. Great meeting, everyone.",
          "at": 26.57,
          "hold": 2.41
        }
      ]
    },
    {
      "id": "s3",
      "name": "mall",
      "title": "DAY 3",
      "subtitle": "THE MALL",
      "duration": 29.45,
      "lines": [
        {
          "id": "s3_01",
          "speaker": "jace",
          "text": "Gentlemen. Welcome... to OUR mall.",
          "at": 2.1,
          "hold": 2.71
        },
        {
          "id": "s3_02",
          "speaker": "dev",
          "text": "Pizza, pretzels, orange chicken, and a smoothie. Best day of my life.",
          "at": 5.21,
          "hold": 4.26
        },
        {
          "id": "s3_03",
          "speaker": "marcus",
          "text": "Guys, this is technically stealing.",
          "at": 9.92,
          "hold": 2.12
        },
        {
          "id": "s3_04",
          "speaker": "jace",
          "text": "Stealing from WHO, Marcus?",
          "at": 12.34,
          "tts": "Stealing from who, Marcus?",
          "hold": 1.53
        },
        {
          "id": "s3_05",
          "speaker": "tank",
          "text": "Five more years.",
          "at": 15.77,
          "hold": 1.34
        },
        {
          "id": "s3_06",
          "speaker": "marcus",
          "text": "I'm calling the arcade. Leader's privilege.",
          "at": 19.01,
          "hold": 2.47
        },
        {
          "id": "s3_07",
          "speaker": "jace",
          "text": "Nobody voted for you!",
          "at": 21.73,
          "hold": 1.14
        },
        {
          "id": "s3_08",
          "speaker": "marcus",
          "text": "Nobody's AROUND to vote!",
          "at": 23.12,
          "hold": 1.53
        },
        {
          "id": "s3_09",
          "speaker": "dev",
          "text": "Can we just... share it?",
          "at": 25.1,
          "hold": 1.85
        },
        {
          "id": "s3_10",
          "speaker": [
            "marcus",
            "jace"
          ],
          "text": "NO.",
          "at": 27.3,
          "tts": "No!",
          "hold": 1.0
        }
      ]
    },
    {
      "id": "s4",
      "name": "wifi",
      "title": "DAY 5",
      "subtitle": "THE SIGNAL",
      "duration": 25.09,
      "lines": [
        {
          "id": "s4_01",
          "speaker": "dev",
          "text": "If there's signal anywhere... it's up there.",
          "at": 2.3,
          "hold": 2.5
        },
        {
          "id": "s4_02",
          "speaker": "dev",
          "text": "Don't look down. Don't look down. Don't look down.",
          "at": 5.7,
          "hold": 3.57
        },
        {
          "id": "s4_03",
          "speaker": "dev",
          "text": "ONE BAR! I HAVE ONE BAR!",
          "at": 11.46,
          "tts": "One bar! I have one bar!",
          "hold": 1.98
        },
        {
          "id": "s4_04",
          "speaker": "dev",
          "text": "Okay. Posting.",
          "at": 13.95,
          "hold": 1.62
        },
        {
          "id": "s4_05",
          "speaker": "dev",
          "text": "...Tough crowd.",
          "at": 19.96,
          "hold": 1.0
        },
        {
          "id": "s4_06",
          "speaker": "tank",
          "text": "Dinner.",
          "at": 21.59,
          "hold": 1.8
        }
      ]
    },
