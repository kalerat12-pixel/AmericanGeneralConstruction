    {
      "id": "s8",
      "name": "sunset",
      "title": "",
      "subtitle": "",
      "duration": 33.6,
      "lines": [
        {
          "id": "s8_01",
          "speaker": "dev",
          "text": "Oh. Hey.",
          "at": 4.2,
          "hold": 1.08
        },
        {
          "id": "s8_02",
          "speaker": "marcus",
          "text": "Hey.",
          "at": 5.78,
          "hold": 1.0
        },
        {
          "id": "s8_03",
          "speaker": "jace",
          "text": "Is this a meeting? Nobody told me there was a meeting.",
          "at": 7.92,
          "hold": 2.96
        },
        {
          "id": "s8_04",
          "speaker": "marcus",
          "text": "It's not a meeting.",
          "at": 11.22,
          "hold": 1.0
        },
        {
          "id": "s8_05",
          "speaker": "tank",
          "text": "Last friend group on Earth... and we still can't agree on pizza.",
          "at": 18.36,
          "hold": 4.19
        },
        {
          "id": "s8_laugh",
          "speaker": "all",
          "text": "*everyone laughs*",
          "at": 22.85,
          "hold": 2.3,
          "kind": "action"
        },
        {
          "id": "s8_06",
          "speaker": "marcus",
          "text": "Rule one. Nobody goes anywhere alone.",
          "at": 25.55,
          "hold": 2.58
        },
        {
          "id": "s8_07",
          "speaker": "jace",
          "text": "Okay. That one's actually a good rule.",
          "at": 28.62,
          "hold": 2.57
        }
      ]
    },
    {
