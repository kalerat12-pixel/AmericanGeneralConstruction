# ---------------------------------------------------------------------------
# Lifting4Gains — environment
#
# Copy to .env.local. Every value below is OPTIONAL: with none of them set the
# app runs fully from the bundled catalog in affiliate mode, which is how
# `npm run dev` works on a fresh clone.
# ---------------------------------------------------------------------------

# --- Business model switch -------------------------------------------------
# "affiliate"  (default) — we hold no stock. Buy actions become tagged outbound
#                          retailer links; checkout records intent, takes no money.
# "inventory"            — we hold stock. The same cart routes to Stripe Checkout,
#                          subscriptions included.
#
# This is a NEXT_PUBLIC_ variable, so it is inlined at BUILD time: change it and
# rebuild (`npm run build`) or restart `npm run dev`.
NEXT_PUBLIC_COMMERCE_MODE=affiliate

# Appended as ?ref= to every outbound retailer link in affiliate mode.
NEXT_PUBLIC_AFFILIATE_TAG=lifting4gains

# Where outbound links point. The default is a retailer search URL, which is
# safe because it can't 404. Replace with your affiliate network's deep-link
# base once you have one.
NEXT_PUBLIC_AFFILIATE_BASE_URL=https://www.ghostlifestyle.com/search?q=

# Canonical URL. Used for metadata, sitemap.xml and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Unset: the site reads the bundled TypeScript catalog and form submissions are
# logged to the server console instead of stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode) ----------------------------------------------------
# Unset in inventory mode: checkout is simulated end to end so the flow stays
# demonstrable without keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
