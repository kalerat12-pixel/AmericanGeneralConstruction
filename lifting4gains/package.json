{
  "name": "lifting4gains",
  "version": "1.0.0",
  "private": true,
  "description": "Lifting4Gains \u2014 a lifter-run storefront for Ghost Energy drinks.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "art": "tsx scripts/generate-art.ts",
    "db:seed-sql": "tsx scripts/generate-seed-sql.ts",
    "check:a11y": "node scripts/checks/a11y.mjs",
    "check:e2e": "node scripts/checks/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "setup": "npm install && npm run art && npm run db:seed-sql",
    "preview": "tsx scripts/build-preview.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
